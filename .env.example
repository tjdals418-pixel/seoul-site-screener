# Copy to `.env` and fill in real values. `.env` is gitignored.

# VWorld API key (https://www.vworld.kr/) — used for coord → cortarNo + 본번/부번
# 그리고 토지특성정보 (LandCharacteristics) — 정밀 용도지역 매핑
VWORLD_API_KEY=

# VWorld 키 발급 시 등록한 도메인. 도메인 mismatch 시 INCORRECT_KEY 응답.
# 마이페이지 → 인증키 → 등록된 도메인 확인 후 입력.
VWORLD_DOMAIN=

# (OPTIONAL) fin.land.naver.com cookie override.
# By default, the crawler auto-acquires fresh cookies each run by visiting
# fin.land/map in a Playwright browser — no manual setup needed.
# Only set this if you want to pin a specific session for debugging:
#   F12 → Network → any /front-api/v1/... request → Headers → cookie: ...
NAVER_COOKIE=
